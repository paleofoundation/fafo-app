{
  "name": "fafo-desktop",
  "productName": "FAFO",
  "version": "2.0.0-m0",
  "description": "Find. Audit. Flag. Oppose. — trademark enforcement case management for The Paleo Foundation",
  "main": "out/main/index.js",
  "private": true,
  "author": "Paleo Certified, Inc. dba The Paleo Foundation",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "electron-vite build && electron-builder --mac",
    "install-app": "npm run package && rm -rf /Applications/FAFO.app && cp -R release/mac-arm64/FAFO.app /Applications/ && echo 'Installed to /Applications/FAFO.app'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@azure/msal-node": "^5.4.2",
    "better-sqlite3": "^13.0.1",
    "docx": "^9.7.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
